'use babel'
// @flow

import type {DiagnosticMode} from '../../DiagnosticsFeature/Types/types.js';

export type DevTool = {
  id: string,
  name: string,
  iconUri: string,
  defaultDiagnosticsMode?: DiagnosticMode
};

export type DevToolWithDiagnostics = DevTool & {
  errors: number,
  successes: number,
  warnings: number,
  infos: number,
};
